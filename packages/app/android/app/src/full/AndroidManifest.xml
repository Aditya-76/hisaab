<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- SMS capture exists ONLY in the `full` flavor (TECH-DESIGN §9).
         The notificationOnly flavor (planned Play Store variant) never has
         these permissions in its manifest. Capture is additionally gated at
         runtime by the worker's explicit opt-in (SmsCapture.kt). -->

    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />

    <application>
        <receiver
            android:name=".capture.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
