{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The app is bundled by Metro, not tsc — this config only typechecks.
    // It is deliberately NOT in the root project references: core/parsers/cli
    // must keep building with zero React Native involvement (TECH-DESIGN §2).
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": []
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["src/**/*.test.ts", "src/testing"]
}
